# Copy to .env.local. Generate PASSCODE_HASH and SESSION_SECRET with `npm run passcode`.

# Local: postgresql://<you>@localhost:5432/fitness
# Vercel: the Neon pooled connection string, with sslmode=require
DATABASE_URL=

PASSCODE_HASH=
SESSION_SECRET=

# Optional until the relevant phase.
ANTHROPIC_API_KEY=

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Used to build the WHOOP redirect URI and webhook URL.
APP_URL=http://localhost:3000
