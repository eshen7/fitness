# Copy to .env.local. Generate PASSCODE_HASH and SESSION_SECRET with `npm run passcode`.

# Local: postgresql://<you>@localhost:5432/fitness
# Vercel: the Neon pooled connection string, with sslmode=require
DATABASE_URL=

PASSCODE_HASH=
SESSION_SECRET=

# Optional until the relevant phase.
ANTHROPIC_API_KEY=

# From a WHOOP developer app. Register the redirect URI as
# <APP_URL>/api/whoop/callback and the webhook URL as <APP_URL>/api/whoop/webhook,
# both exactly, since the redirect URI is compared string for string. Leaving
# these unset is supported: recovery, sleep and strain stay blank and every other
# part of the check-in works unchanged.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Bearer for the nightly sync in vercel.json, which runs outside the passcode gate
# because a cron has no session. Unset means scheduled syncs are refused and only
# the manual "Sync now" button works. Any long random string.
CRON_SECRET=

# Used to build the WHOOP redirect URI and webhook URL.
APP_URL=http://localhost:3000
